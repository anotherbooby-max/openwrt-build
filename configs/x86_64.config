#
# LEDE x86_64 configuration
#

# ============================================================
# Target
# ============================================================

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

CONFIG_TARGET_x86_64_DEVICE_generic=y

# ============================================================
# Image formats
# ============================================================

CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# ============================================================
# Base system
# ============================================================

CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ============================================================
# LuCI
# ============================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y

# ============================================================
# Wireless basic
# ============================================================

CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y

# ============================================================
# Linux wireless stack
# ============================================================

CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-mac80211-hwsim=n

# ============================================================
# Intel WiFi
#
# Intel WiFi Link 5100
# PCI ID: 8086:4232
# Driver: iwlwifi
# ============================================================

CONFIG_PACKAGE_kmod-iwlwifi=y

# Intel 5000 series firmware
CONFIG_PACKAGE_iwlwifi-firmware-iwlwifi-5000-ucode=y

# ============================================================
# USB / PCI related tools
# ============================================================

CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y

# ============================================================
# Network tools
# ============================================================

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_net-tools=y
CONFIG_PACKAGE_ethtool=y

# ============================================================
# OpenVPN
# ============================================================

CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn=y

# ============================================================
# SSH
# ============================================================

CONFIG_PACKAGE_openssh-client=y

# ============================================================
# Firewall / NAT
# ============================================================

CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-tproxy=y

# ============================================================
# Kernel modules
# ============================================================

CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# ============================================================
# USB support
# ============================================================

CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# ============================================================
# Filesystem
# ============================================================

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-overlay=y

# ============================================================
# Useful system tools
# ============================================================

CONFIG_PACKAGE-bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y

# ============================================================
# IPv6
# ============================================================

CONFIG_PACKAGE_ipv6helper=y

# ============================================================
# Kernel modules useful for x86
# ============================================================

CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-r8168=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y

# ============================================================
# Development / diagnostics
# ============================================================

CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-ps=y

# ============================================================
# Disable unnecessary targets
# ============================================================

CONFIG_TARGET_ROOTFS_TARGZ=n
