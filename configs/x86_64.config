CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

#
# x86 image
#

CONFIG_TARGET_IMAGES_GZIP=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y

CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=512

CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

CONFIG_GRUB_CONSOLE=y

#
# Base system
#

CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y

#
# LuCI
#

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y

#
# Wireless subsystem
#

CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-iwlwifi=y

#
# Intel WiFi Link 5100 firmware
#

CONFIG_PACKAGE_iwlwifi-firmware-iwlwifi-5000-5=y

#
# Wireless tools
#

CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y

#
# Wireless configuration
#

CONFIG_PACKAGE_wireless-tools=y

#
# AP / hostapd / wpad
#

CONFIG_PACKAGE_wpad=y

#
# Basic wireless support
#

CONFIG_PACKAGE_kmod-rfkill=y
CONFIG_PACKAGE_rfkill=y

#
# USB / PCI utilities
#

CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y

#
# Network tools
#

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE ca-certificates=y

#
# IPv6
#

CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ipv6=y

#
# PPP
#

CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y

#
# Useful diagnostics
#

CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_net-tools=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-ps=y

#
# Kernel wireless related options
#

CONFIG_PACKAGE_kmod-crypto-cmac=y
CONFIG_PACKAGE_kmod-crypto-ccm=y
CONFIG_PACKAGE_kmod-crypto-ctr=y
CONFIG_PACKAGE_kmod-crypto-gcm=y

#
# Hostapd dependencies
#

CONFIG_PACKAGE_libnl-core=y
CONFIG_PACKAGE_libnl-genl=y
CONFIG_PACKAGE_libnl-nf=y
CONFIG_PACKAGE_libnl-route=y

#
# Firmware
#

CONFIG_PACKAGE_iwlwifi-firmware=y
