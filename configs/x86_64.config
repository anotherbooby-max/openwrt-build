
CONFIG_TARGET_x86=y

CONFIG_TARGET_x86_64=y

CONFIG_TARGET_x86_64_Generic=y



#
# LuCI
#

CONFIG_PACKAGE_luci=y

CONFIG_PACKAGE_luci-base=y

CONFIG_PACKAGE_luci-compat=y



#
# Kernel wireless
#

CONFIG_PACKAGE_kmod-mac80211=y

CONFIG_PACKAGE_kmod-cfg80211=y

CONFIG_PACKAGE_kmod-lib80211=y



#
# Intel wireless
#

CONFIG_PACKAGE_kmod-iwlwifi=y

CONFIG_PACKAGE_iw=y

CONFIG_PACKAGE_iwinfo=y



#
# Firmware
#

CONFIG_PACKAGE_iwlwifi-firmware=y

CONFIG_PACKAGE_iwlwifi-firmware-5000=y



#
# AP
#

CONFIG_PACKAGE_hostapd-common=y

CONFIG_PACKAGE_wpad=y



#
# USB / PCI
#

CONFIG_PACKAGE_pciutils=y

CONFIG_PACKAGE_usbutils=y



#
# Network
#

CONFIG_PACKAGE_ip-full=y

CONFIG_PACKAGE_ethtool=y



#
# filesystem
#

CONFIG_TARGET_ROOTFS_SQUASHFS=y


#
# x86 image
#

CONFIG_GRUB_IMAGES=y

CONFIG_GRUB_CONSOLE=y


#
# IMPORTANT
# 使用普通BIOS兼容
#

# CONFIG_EFI_IMAGES is not set


#
# Kernel
#

CONFIG_TARGET_KERNEL_PARTSIZE=128


#
# Disable risky options
#

# CONFIG_PACKAGE_kexec-tools is not set

# CONFIG_PACKAGE_kmod-kvm-intel is not set
