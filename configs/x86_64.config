#
# LEDE x86_64 custom configuration
#

# =========================================================
# Target
# =========================================================

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-O2 -pipe -march=x86-64"

# =========================================================
# Root filesystem
# =========================================================

CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

CONFIG_TARGET_IMAGES_GZIP=y

# =========================================================
# LuCI
# =========================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y

# HTTPS LuCI
CONFIG_PACKAGE_luci-ssl=y

# =========================================================
# Network
# =========================================================

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y

CONFIG_PACKAGE_tcpdump=y

# =========================================================
# Firewall
# =========================================================

CONFIG_PACKAGE_firewall=y

# =========================================================
# Wireless base
# =========================================================

CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

# =========================================================
# Intel WiFi Link 5100
# PCI ID: 8086:4232
# =========================================================

CONFIG_PACKAGE_kmod-iwlwifi=y

CONFIG_PACKAGE_iwlwifi-firmware-iwl5000=y

# Wireless regulatory database
CONFIG_PACKAGE_wireless-regdb=y

# Wireless tools
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# HostAP
CONFIG_PACKAGE_hostapd-common=y

# WPA
CONFIG_PACKAGE_wpad-openssl=y

# =========================================================
# USB / PCI / hardware
# =========================================================

CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y

# =========================================================
# CPU / x86 hardware
# =========================================================

CONFIG_PACKAGE_iucode-tool=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8169=y

# =========================================================
# Storage
# =========================================================

CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mount-utils=y

# =========================================================
# SSH
# =========================================================

CONFIG_PACKAGE_dropbear=y

# =========================================================
# OpenVPN
# =========================================================

CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn=y

# =========================================================
# SSR Plus
# =========================================================

CONFIG_PACKAGE_luci-app-ssr-plus=y

# SSR Plus common backends
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=y
CONFIG_PACKAGE_shadowsocks-libev-ss-server=y

# =========================================================
# DNS
# =========================================================

CONFIG_PACKAGE_dnsmasq=y

# =========================================================
# IPv6
# =========================================================

CONFIG_PACKAGE_ipv6helper=y

# =========================================================
# Useful utilities
# =========================================================

CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_jq=y

# =========================================================
# LuCI system tools
# =========================================================

CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# =========================================================
# Kernel modules useful for WiFi
# =========================================================

CONFIG_PACKAGE_kmod-rfkill=y

# =========================================================
# Wireless firmware
# =========================================================

CONFIG_PACKAGE_iwlwifi-firmware-iwl5000=y

# =========================================================
# Do NOT select unnecessary drivers
# =========================================================

# Broadcom
# CONFIG_PACKAGE_kmod-brcmfmac is not set

# Qualcomm/Atheros
# CONFIG_PACKAGE_kmod-ath9k is not set
# CONFIG_PACKAGE_kmod-ath10k is not set
# CONFIG_PACKAGE_kmod-ath11k is not set

# MediaTek
# CONFIG_PACKAGE_kmod-mt76 is not set

# Realtek WiFi
# CONFIG_PACKAGE_kmod-rtl8xxxu is not set

# =========================================================
# Build information
# =========================================================

CONFIG_DEVEL=y
