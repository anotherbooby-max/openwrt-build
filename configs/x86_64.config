CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y


#
# Image
#

CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y


CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024



#
# Kernel
#

CONFIG_KERNEL_X86_MSR=y

CONFIG_KERNEL_BLK_DEV_SD=y

CONFIG_KERNEL_SATA_AHCI=y


#
# PCI
#

CONFIG_PCI=y
CONFIG_PCI_MSI=y



#
# Intel Wireless 5100
#

CONFIG_PACKAGE_kmod-iwlwifi=y

CONFIG_PACKAGE_iwlwifi-firmware=y


CONFIG_PACKAGE_iwlwifi-firmware-5000=y


#
# mac80211
#

CONFIG_PACKAGE_kmod-mac80211=y

CONFIG_PACKAGE_kmod-cfg80211=y


CONFIG_PACKAGE_iw=y


#
# Wireless tools
#

CONFIG_PACKAGE_wireless-regdb=y


#
# AP
#

CONFIG_PACKAGE_wpad=y

CONFIG_PACKAGE_wpad-basic=y


CONFIG_PACKAGE_hostapd-utils=y


#
# LuCI
#

CONFIG_PACKAGE_luci=y

CONFIG_PACKAGE_luci-ssl=y


#
# Network
#

CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_odhcpd-ipv6only=y



#
# USB
#

CONFIG_PACKAGE_kmod-usb-core=y

CONFIG_PACKAGE_kmod-usb2=y



#
# Ethernet
#

CONFIG_PACKAGE_kmod-e1000=y

CONFIG_PACKAGE_kmod-e1000e=y

CONFIG_PACKAGE_kmod-r8169=y



#
# Disable problematic drivers
#

# CONFIG_PACKAGE_kmod-nvidia is not set

# CONFIG_PACKAGE_kmod-amdgpu is not set



#
# CPU microcode
#

CONFIG_PACKAGE_iucode-tool=y

CONFIG_PACKAGE_intel-microcode=y
